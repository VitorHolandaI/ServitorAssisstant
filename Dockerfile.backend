FROM python:3.11-slim

# portaudio19-dev, gcc and python3-dev were here to compile pyaudio, which the
# server does not install: it reads audio from files, not from a microphone.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libgomp1 \
    espeak-ng \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (layer cache)
COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt

# Copy application code
COPY api/ ./api/

ENV PYTHONPATH=/app/api

# Run as a normal user. uid 1000 matches the host account that owns the bind
# mounts, so voice_models and the certificates stay readable without loosening
# anything on the host.
#
# /app/data has to exist and be owned here, before the volume is attached: a
# named volume mounted over a path that exists in the image inherits that
# path's contents and ownership on first use. Created empty by the daemon
# instead, it would belong to root and the application could not write to it.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/data \
    && chown -R app:app /app

USER app

WORKDIR /app/api
