# Template - copy to .env in the repository root and fill in your values.

# IP of this machine (used to build MCP address; in Docker, set to "mcp")
SERVER_IP=localhost

# Ollama base URL (in Docker, set to "http://ollama:11434")
OLLAMA_HOST=http://127.0.0.1:11434

# Seconds allowed for an on-demand context token count (/context_usage).
# Counting sends the prompt to /api/chat with num_predict=1; a cold model load
# can take a while, so keep this generous.
TOKEN_COUNT_TIMEOUT=30

# IP of the Raspberry Pi client that plays audio
CLIENT_IP=192.168.0.22

# Absolute path to the Piper TTS voice model (.onnx)
VOICE_PATH=/home/vitor/git/ServitorAssisstant/voice_models/en_US-ryan-medium.onnx

# Wake-on-LAN — MAC address of the machine to wake
WAKE_MAC=YOUR_MAC_HERE

# Network interface to send the magic packet through (Proxmox bridge, etc.)
WAKE_INTERFACE=vmbr0

# Extra MCP servers consumed by the backend, comma-separated
MCP_EXTRA_ADDRESSES=http://localhost:8002/mcp

# Weekly dev activity MCP
DEV_ACTIVITY_MCP_HOST=0.0.0.0
DEV_ACTIVITY_MCP_PORT=8002
DEV_ACTIVITY_TIMEZONE=America/Recife

# GitHub activity source
GITHUB_USERNAME=VitorHolandaI
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# Gitea activity source
GITEA_BASE_URL=http://10.66.66.11:3000
GITEA_USERNAME=vitor
GITEA_TOKEN=

# Nextcloud task integration
NC_URL=https://cloud.example.com
NC_USER=your-user-id
NC_APP_PASSWORD=your-app-password
NC_TIMEZONE=America/Recife
# Optional custom CA file. By default the operating system trust store is used.
NC_CA_BUNDLE=
# Keep true when possible. Use false only for a trusted private network with
# a self-signed certificate that is not installed on the MCP host/container.
NC_TLS_VERIFY=true

# Optional. Set these only if automatic calendar selection is ambiguous.
NC_TASK_CALENDAR=
NC_REMINDER_CALENDAR=

# Home Assistant MCP (official "Model Context Protocol Server" integration,
# Assist API). Leave HOME_ASSISTANT_MCP_URL empty to disable the integration.
HOME_ASSISTANT_MCP_URL=
# Path to a file holding a Home Assistant long-lived access token, mode 0600.
# Keep it outside the repository — never paste the token itself here.
HOME_ASSISTANT_TOKEN_FILE=~/.config/servitor/ha-token
# Private CA that signed the Home Assistant certificate. Keep it outside the
# repository; scripts/resync_server.sh copies it to the server. Leave empty to
# use the public CA bundle. Never disable verification.
HOME_ASSISTANT_CA_BUNDLE=~/.config/servitor/ha-root-ca.crt

# ── Wake-word listener (laptop only, api/ear) ────────────────────────────
# Runs entirely on this machine: nothing here talks to the Servitor server.
# Every value below is optional; the defaults are what scripts/install_ear.sh
# expects. Leave a line blank to take the default.
#
# The phrase must be words the Vosk model actually knows — a word outside its
# lexicon is silently ignored and the ear then never wakes. Measured on the
# English model: "hey <rare word>" wakes 4/4 and never false-fires on 14
# distractor sentences, while a bare common word like "wake" false-fires.
EAR_WAKE_PHRASE=hey oracle
EAR_VOSK_MODEL=
EAR_VOICE=
EAR_ACK_TEXT=I'm here.
# Whisper transcribes the command in whatever language it was spoken.
# NPU is the low-power choice and is safe here only because the pipeline is
# rebuilt per utterance — see api/ear/transcribe.py. GPU and CPU also work.
EAR_WHISPER_MODEL=
EAR_WHISPER_DEVICE=NPU
# The local model that answers. NPU is slower than GPU (~4s vs ~1s per reply)
# but survives desktop memory pressure; GPU raised CL_OUT_OF_RESOURCES with
# 8 GB of other applications running.
EAR_LLM_MODEL=
EAR_LLM_DEVICE=NPU
# Recording: how long a pause ends a command, and the hard ceiling on one.
EAR_SILENCE_SECONDS=1.2
EAR_MAX_COMMAND_SECONDS=15
EAR_MIN_COMMAND_SECONDS=0.4
# Set false to start with the microphone closed; the bar widget toggles it.
EAR_START_ENABLED=true
